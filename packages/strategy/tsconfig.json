{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "spool-strategy": ["./src/index.ts"]
    }
  },
  "include": ["src", "scripts", "test", "../../benchmarks/**/strategies/*.ts", "../../benchmarks/**/extractors/*.ts"]
}
