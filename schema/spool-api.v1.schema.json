{
  "$defs": {
    "Actor": {
      "description": "Who authored a changeset: `engine`, `user:<id>` or `agent:<id>`.",
      "pattern": "^(engine|user:.+|agent:.+)$",
      "type": "string"
    },
    "CandidateList": {
      "description": "`GET /v1/runs/{run}/candidates` when JSON is asked for. Each candidate has\n`left_id`, `right_id`, and every feature column prefixed with `left_` and\nwith `right_`.",
      "properties": {
        "candidates": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "candidates"
      ],
      "type": "object"
    },
    "Changeset": {
      "description": "An ordered list of operations that is applied atomically or not at all.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "base": {
          "$ref": "#/$defs/Seq",
          "description": "The log position the author had seen."
        },
        "id": {
          "$ref": "#/$defs/ChangesetId"
        },
        "ops": {
          "items": {
            "$ref": "#/$defs/Op"
          },
          "type": "array"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The reconcile run that drafted it, if any."
        }
      },
      "required": [
        "id",
        "base",
        "actor",
        "ops"
      ],
      "type": "object"
    },
    "ChangesetId": {
      "description": "Identifies a changeset, and the draft it was while it waited.",
      "format": "uuid",
      "type": "string"
    },
    "ChangesetList": {
      "description": "`GET /v1/changesets`: a page of the log.",
      "properties": {
        "changesets": {
          "items": {
            "$ref": "#/$defs/LogEntry"
          },
          "type": "array"
        },
        "head": {
          "$ref": "#/$defs/Seq",
          "description": "The position of the last committed changeset."
        }
      },
      "required": [
        "changesets",
        "head"
      ],
      "type": "object"
    },
    "Committed": {
      "description": "The receipt for a committed changeset.",
      "properties": {
        "changeset": {
          "$ref": "#/$defs/ChangesetId"
        },
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        }
      },
      "required": [
        "seq",
        "changeset",
        "content_hash"
      ],
      "type": "object"
    },
    "ConstraintKind": {
      "enum": [
        "must_link",
        "cannot_link"
      ],
      "type": "string"
    },
    "ContentHash": {
      "description": "SHA-256 of the canonical encoding of a list of operations, as lowercase hex.",
      "type": "string"
    },
    "DraftList": {
      "properties": {
        "drafts": {
          "items": {
            "$ref": "#/$defs/DraftSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "drafts"
      ],
      "type": "object"
    },
    "DraftRecord": {
      "description": "A draft with the changeset it would commit.",
      "properties": {
        "changeset": {
          "$ref": "#/$defs/Changeset"
        },
        "draft": {
          "$ref": "#/$defs/DraftSummary"
        }
      },
      "required": [
        "draft",
        "changeset"
      ],
      "type": "object"
    },
    "DraftStatus": {
      "enum": [
        "open",
        "committed",
        "rejected",
        "superseded"
      ],
      "type": "string"
    },
    "DraftSummary": {
      "description": "A draft without its operations.",
      "properties": {
        "base": {
          "$ref": "#/$defs/Seq",
          "description": "The log position it was drafted against."
        },
        "committed_seq": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seq"
            },
            {
              "type": "null"
            }
          ],
          "description": "Committed: its position in the log."
        },
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "id": {
          "$ref": "#/$defs/ChangesetId",
          "description": "The ID of the changeset, which is how a draft is named."
        },
        "identities_created": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "match_run": {
          "$ref": "#/$defs/RunId",
          "description": "The match run whose judgements the draft rests on."
        },
        "observations_assigned": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "operations": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reconcile_run": {
          "$ref": "#/$defs/RunId",
          "description": "The reconcile run that drafted it."
        },
        "rejected_at": {
          "description": "Rejected: when.",
          "type": [
            "string",
            "null"
          ]
        },
        "rejected_reason": {
          "description": "Rejected: why, if the reviewer said.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/DraftStatus"
        },
        "superseded_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Superseded: the reconcile run that drafted the entity type again."
        }
      },
      "required": [
        "id",
        "entity_type",
        "match_run",
        "reconcile_run",
        "base",
        "status",
        "operations",
        "identities_created",
        "observations_assigned"
      ],
      "type": "object"
    },
    "EntityType": {
      "description": "The name of an entity type the project declares.",
      "pattern": "^[a-z][a-z0-9_]{0,47}$",
      "type": "string"
    },
    "ErrorBody": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "rejections": {
          "description": "With `rejected`: the operations of the changeset that broke a rule.",
          "items": {
            "$ref": "#/$defs/Rejection"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "oneOf": [
        {
          "const": "unauthorized",
          "description": "401: the bearer token is missing or wrong.",
          "type": "string"
        },
        {
          "const": "invalid",
          "description": "400: the request cannot be read, or names something that is not\ndeclared.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "404: there is no such run, draft, identity, observation or path.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "409: the thing exists and is not in a state that allows this.",
          "type": "string"
        },
        {
          "const": "rejected",
          "description": "409: the changeset broke a rule. `rejections` names the operations.",
          "type": "string"
        },
        {
          "const": "too_large",
          "description": "413: the body is larger than the server reads.",
          "type": "string"
        },
        {
          "const": "internal",
          "description": "500: the server failed.",
          "type": "string"
        }
      ]
    },
    "ErrorResponse": {
      "description": "The body of every response that is not a success.",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorBody"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "FeatureColumn": {
      "properties": {
        "data_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "data_type"
      ],
      "type": "object"
    },
    "History": {
      "properties": {
        "history": {
          "items": {
            "$ref": "#/$defs/HistoryEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "history"
      ],
      "type": "object"
    },
    "HistoryEntry": {
      "description": "A committed changeset as far as it concerns one identity.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "changeset": {
          "$ref": "#/$defs/ChangesetId"
        },
        "committed_at": {
          "type": "string"
        },
        "ops": {
          "description": "The operations that name the identity, in the order they were applied.",
          "items": {
            "$ref": "#/$defs/Op"
          },
          "type": "array"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The reconcile run that drafted it, if one did."
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        }
      },
      "required": [
        "seq",
        "changeset",
        "actor",
        "committed_at",
        "ops"
      ],
      "type": "object"
    },
    "IdentitiesOfRequest": {
      "additionalProperties": false,
      "description": "`POST /v1/observations/identities`: the identities of many observations\nin one call.",
      "properties": {
        "observations": {
          "items": {
            "$ref": "#/$defs/ObservationId"
          },
          "type": "array"
        }
      },
      "required": [
        "observations"
      ],
      "type": "object"
    },
    "IdentitiesOfResponse": {
      "properties": {
        "identities": {
          "description": "One entry per observation asked about, in the same order. `null` for\nan observation that has no identity or is not known.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdentityId"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "identities"
      ],
      "type": "object"
    },
    "IdentityId": {
      "description": "Identifies an identity. Minted once, never derived from content and never reused.",
      "format": "uuid",
      "type": "string"
    },
    "IdentityList": {
      "properties": {
        "identities": {
          "items": {
            "$ref": "#/$defs/IdentitySummary"
          },
          "type": "array"
        },
        "next": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdentityId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pass as `after` for the next page. `null` on the last page."
        }
      },
      "required": [
        "identities"
      ],
      "type": "object"
    },
    "IdentitySummary": {
      "description": "An active identity in a list.",
      "properties": {
        "created": {
          "$ref": "#/$defs/Seq"
        },
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "id": {
          "$ref": "#/$defs/IdentityId"
        },
        "members": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "entity_type",
        "created",
        "members"
      ],
      "type": "object"
    },
    "IdentityView": {
      "description": "An identity and the observations that belong to it now.",
      "properties": {
        "created": {
          "$ref": "#/$defs/Seq",
          "description": "The log position that created the identity that was asked for."
        },
        "current": {
          "$ref": "#/$defs/IdentityId",
          "description": "The active identity it stands for: itself, or the one it was merged\ninto."
        },
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "id": {
          "$ref": "#/$defs/IdentityId",
          "description": "The ID that was asked for."
        },
        "members": {
          "description": "The members of the current identity, ordered by observation ID.",
          "items": {
            "$ref": "#/$defs/Member"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "current",
        "entity_type",
        "created",
        "members"
      ],
      "type": "object"
    },
    "Info": {
      "description": "`GET /v1/info`.",
      "properties": {
        "api": {
          "description": "The version of the API this server speaks.",
          "type": "string"
        },
        "store": {
          "$ref": "#/$defs/StoreInfo"
        }
      },
      "required": [
        "api",
        "store"
      ],
      "type": "object"
    },
    "IngestReport": {
      "properties": {
        "duplicates": {
          "description": "Rows that were already known, or repeated within this call.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "inserted": {
          "description": "Observations created.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "received": {
          "description": "Rows received.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "run",
        "received",
        "inserted",
        "duplicates"
      ],
      "type": "object"
    },
    "IngestRequest": {
      "additionalProperties": false,
      "description": "`POST /v1/ingest` with a JSON body. With an Arrow body, the same fields\nother than `rows` are query parameters.",
      "properties": {
        "entity_type": {
          "type": "string"
        },
        "evidence": {
          "default": null,
          "description": "A column of JSON text that says where each row was found.",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "default": null,
          "description": "The column that holds each row's key within the source.",
          "type": [
            "string",
            "null"
          ]
        },
        "rows": {
          "description": "One object per row. A column holds text, booleans or numbers.",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "source": {
          "description": "The name of the source the rows come from.",
          "type": "string"
        },
        "wait_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "entity_type",
        "rows"
      ],
      "type": "object"
    },
    "Judgement": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": null,
          "description": "Anything the strategy wants kept with the judgement."
        },
        "left_id": {
          "$ref": "#/$defs/ObservationId"
        },
        "right_id": {
          "$ref": "#/$defs/ObservationId"
        },
        "score": {
          "default": null,
          "description": "On the strategy's own scale. Scores are never compared across\nstrategies.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "left_id",
        "right_id",
        "verdict"
      ],
      "type": "object"
    },
    "JudgementCounts": {
      "properties": {
        "match": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "no_match": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unsure": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "match",
        "no_match",
        "unsure"
      ],
      "type": "object"
    },
    "JudgementsRequest": {
      "additionalProperties": false,
      "description": "`POST /v1/runs/{run}/judgements` with a JSON body.",
      "properties": {
        "judgements": {
          "items": {
            "$ref": "#/$defs/Judgement"
          },
          "type": "array"
        }
      },
      "required": [
        "judgements"
      ],
      "type": "object"
    },
    "JudgementsResponse": {
      "properties": {
        "stored": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "stored"
      ],
      "type": "object"
    },
    "LogEntry": {
      "description": "A committed changeset as the log holds it.",
      "properties": {
        "changeset": {
          "$ref": "#/$defs/Changeset"
        },
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        }
      },
      "required": [
        "seq",
        "changeset",
        "content_hash"
      ],
      "type": "object"
    },
    "Member": {
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "observation": {
          "$ref": "#/$defs/ObservationId"
        },
        "since": {
          "$ref": "#/$defs/Seq",
          "description": "The log position that placed it here."
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "observation",
        "source",
        "since"
      ],
      "type": "object"
    },
    "MintRequest": {
      "additionalProperties": false,
      "description": "`POST /v1/ids`: IDs for a caller that writes its own changeset.",
      "properties": {
        "changesets": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "identities": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "MintedIds": {
      "description": "IDs minted for a caller that writes its own changesets.",
      "properties": {
        "changesets": {
          "items": {
            "$ref": "#/$defs/ChangesetId"
          },
          "type": "array"
        },
        "identities": {
          "items": {
            "$ref": "#/$defs/IdentityId"
          },
          "type": "array"
        }
      },
      "required": [
        "identities",
        "changesets"
      ],
      "type": "object"
    },
    "ObservationId": {
      "description": "Identifies an observation. Derived by the engine from the observation's source, key and content.",
      "format": "uuid",
      "type": "string"
    },
    "ObservationList": {
      "properties": {
        "next": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pass as `after` for the next page. `null` on the last page."
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/ObservationRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "observations"
      ],
      "type": "object"
    },
    "ObservationRecord": {
      "description": "An observation as it was ingested, and the identity it belongs to now.",
      "properties": {
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "evidence": {
          "description": "Where in the source the observation was found, if the source said."
        },
        "id": {
          "$ref": "#/$defs/ObservationId"
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdentityId"
            },
            {
              "type": "null"
            }
          ],
          "description": "`None` while no changeset has placed it."
        },
        "ingest_run": {
          "$ref": "#/$defs/RunId"
        },
        "ingested_at": {
          "type": "string"
        },
        "key": {
          "description": "The row's key within its source, if it had one.",
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "description": "The attributes exactly as received."
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "entity_type",
        "source",
        "payload",
        "ingested_at",
        "ingest_run"
      ],
      "type": "object"
    },
    "Op": {
      "description": "One change to identity state. Each operation carries its own precondition,\nwhich is checked against the state the changeset is committed to.\n\n`Merge`, `Constrain`, `Unconstrain` and `Reinstate` are part of the format\nand are not implemented yet: a changeset that contains one is rejected.",
      "oneOf": [
        {
          "description": "Precondition: the ID has never been used.",
          "properties": {
            "entity_type": {
              "$ref": "#/$defs/EntityType"
            },
            "identity": {
              "$ref": "#/$defs/IdentityId"
            },
            "op": {
              "const": "create_identity",
              "type": "string"
            }
          },
          "required": [
            "op",
            "identity",
            "entity_type"
          ],
          "type": "object"
        },
        {
          "description": "Attach (`from` is `None`), move, or detach (`to` is `None`).\nPrecondition: `from` is the observation's current identity.",
          "properties": {
            "from": {
              "anyOf": [
                {
                  "$ref": "#/$defs/IdentityId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observation": {
              "$ref": "#/$defs/ObservationId"
            },
            "op": {
              "const": "assign",
              "type": "string"
            },
            "to": {
              "anyOf": [
                {
                  "$ref": "#/$defs/IdentityId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "op",
            "observation"
          ],
          "type": "object"
        },
        {
          "description": "Moves every current member of `from` to `into` and redirects `from`.",
          "properties": {
            "from": {
              "$ref": "#/$defs/IdentityId"
            },
            "into": {
              "$ref": "#/$defs/IdentityId"
            },
            "op": {
              "const": "merge",
              "type": "string"
            }
          },
          "required": [
            "op",
            "from",
            "into"
          ],
          "type": "object"
        },
        {
          "properties": {
            "a": {
              "$ref": "#/$defs/ObservationId"
            },
            "b": {
              "$ref": "#/$defs/ObservationId"
            },
            "kind": {
              "$ref": "#/$defs/ConstraintKind"
            },
            "op": {
              "const": "constrain",
              "type": "string"
            }
          },
          "required": [
            "op",
            "kind",
            "a",
            "b"
          ],
          "type": "object"
        },
        {
          "properties": {
            "a": {
              "$ref": "#/$defs/ObservationId"
            },
